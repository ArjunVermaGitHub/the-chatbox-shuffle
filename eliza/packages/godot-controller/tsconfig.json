//eliza/packages/godot-controller/tsconfig.json
{
  "extends": "../../tsconfig.base.json", // Extend from root tsconfig if it exists
  "compilerOptions": {
    "outDir": "./dist", // Specify output directory
    "rootDir": "./src", // Specify root source directory
    "baseUrl": ".", // Base URL for path resolution
    "paths": {
      // Helps TS find the local plugin during development build
      "eliza-godot-plugin": ["../eliza-godot-plugin/src"],
      "eliza-godot-plugin/*": ["../eliza-godot-plugin/src/*"],
      // Add paths for other core/plugin dependencies if needed
      "@elizaos/core": ["../core/src"],
      "@elizaos/core/*": ["../core/src/*"],
      "@elizaos/plugin-sql": ["../plugin-sql/src"],
      "@elizaos/plugin-sql/*": ["../plugin-sql/src/*"],
      "@elizaos/plugin-openrouter": ["../plugin-openrouter/src"],
      "@elizaos/plugin-openrouter/*": ["../plugin-openrouter/src/*"]
      // Add other workspace packages as needed
    },
    "composite": true // Often needed with project references or paths in monorepos
    // Include other necessary compiler options from your base tsconfig or defaults
  },
  "include": ["src/**/*.ts"], // Ensure only source files are included
  "exclude": ["node_modules", "dist"]
  // Add references if using TS project references (alternative to paths)
  // "references": [
  //   { "path": "../core" },
  //   { "path": "../eliza-godot-plugin" }
  // ]
}
