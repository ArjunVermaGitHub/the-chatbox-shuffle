{
  "name": "@elizaos/plugin-openrouter",
  "version": "1.0.0-beta.7",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaos/eliza.git",
    "directory": "packages/plugin-openrouter"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/openai": "^1.1.9",
    "@elizaos/core": "^1.0.0-beta.7",
    "ai": "^4.1.25",
    "zod": "^3.24.2",
    "fastembed": "^1.14.1",
    "fs-extra": "11.2.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "prettier --write ./src",
    "clean": "rm -rf dist .turbo node_modules .turbo-tsconfig.json tsconfig.tsbuildinfo",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "OPENROUTER_API_KEY": {
        "type": "string",
        "description": "API key for the OpenRouter service (Required for Text/Object Generation)"
      },
      "OPENROUTER_BASE_URL": {
        "type": "string",
        "description": "Custom base URL for OpenRouter API (Optional, defaults to https://openrouter.ai/api/v1)"
      },
      "OPENROUTER_SMALL_MODEL": {
        "type": "string",
        "description": "Model name from OpenRouter to use for TEXT_SMALL tasks (e.g., 'openai/gpt-4o-mini') (Required)"
      },
      "OPENROUTER_LARGE_MODEL": {
        "type": "string",
        "description": "Model name from OpenRouter to use for TEXT_LARGE/OBJECT_LARGE tasks (e.g., 'google/gemini-flash-1.5') (Required)"
      },
      "OPENROUTER_EMBEDDING_MODEL": {
        "type": "string",
        "description": "DEPRECATED: Embeddings are handled locally via fastembed (BGESmallENV15). This setting is ignored."
      }
    }
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "prettier": "3.5.3",
    "tsup": "^8.4.0"
  }
}
